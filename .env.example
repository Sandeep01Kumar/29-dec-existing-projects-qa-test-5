# Environment Configuration Template
# Copy this file to .env and customize values for your environment
# NEVER commit .env file to version control (it contains secrets)

# =============================================================================
# Server Configuration
# =============================================================================

# HTTP server listening port (default: 3000)
PORT=3000

# HTTP server binding address
# Use 0.0.0.0 for container deployments, 127.0.0.1 for local only
HOST=0.0.0.0

# =============================================================================
# Application Configuration
# =============================================================================

# Environment mode: development | staging | production
# Affects logging format, error detail level, and security headers
NODE_ENV=development

# =============================================================================
# Logging Configuration
# =============================================================================

# Minimum log level: error | warn | info | http | debug
# Production recommended: info or warn
# Development recommended: debug
LOG_LEVEL=info
